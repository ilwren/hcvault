<Window x:Class="HCVault.Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HCVault Explorer" Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================= volume bar ============================= -->
        <GroupBox Grid.Row="0" Header="Volume" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="VolumePath" VerticalContentAlignment="Center"
                         Text="C:\Volumes\demo.hc" ToolTip="Path of the .hc container file" />
                <Button Grid.Column="1" x:Name="BrowseButton" Content="..." Margin="4,0,0,0" Click="Browse_OnClick" />
                <Button Grid.Column="2" x:Name="CreateButton" Content="Create..." Margin="8,0,0,0" Click="Create_OnClick" />
                <Button Grid.Column="3" x:Name="OpenButton" Content="Open / Close" IsDefault="True" Click="Open_OnClick" />
            </Grid>
        </GroupBox>

        <!-- ============================ credentials ============================= -->
        <GroupBox Grid.Row="1" Header="Credentials" Padding="6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <PasswordBox Grid.Row="0" Grid.Column="0" x:Name="Password" VerticalContentAlignment="Center"
                             ToolTip="Password" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="PIM:" Margin="12,0,4,0" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="2" x:Name="PimBox" VerticalContentAlignment="Center" Text="0"
                         ToolTip="0 = default iterations" />
                <TextBox Grid.Row="0" Grid.Column="3" Width="10" Visibility="Collapsed" />

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Key file:" VerticalAlignment="Center" />
                    <TextBox x:Name="KeyFileBox" Width="220" Margin="4,0,0,0" VerticalContentAlignment="Center"
                             ToolTip="Optional key file path (leave empty for none)" />
                    <Button Content="Key..." Margin="4,0,12,0" Click="KeyFile_OnClick" />
                    <TextBlock Text="KDF:" VerticalAlignment="Center" />
                    <TextBlock x:Name="KdfLabel" Margin="4,0,12,0" VerticalAlignment="Center" Text="-" FontWeight="Bold" />
                    <TextBlock Text="Cipher:" VerticalAlignment="Center" />
                    <TextBlock x:Name="CipherLabel" Margin="4,0,12,0" VerticalAlignment="Center" Text="-" FontWeight="Bold" />
                    <TextBlock x:Name="HiddenLabel" VerticalAlignment="Center" Text="" FontWeight="Bold" Foreground="DarkOrange" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ============================== explorer ============================== -->
        <GroupBox Grid.Row="2" Header="Files inside the volume" Padding="6" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="CurrentDir" Text="\" VerticalAlignment="Center" FontWeight="Bold" />
                    <Button Content="Up" Margin="8,0,0,0" Click="Up_OnClick" />
                    <Button Content="New folder" Margin="4,0,0,0" Click="NewFolder_OnClick" />
                    <Button Content="Import file..." Margin="4,0,0,0" Click="Import_OnClick" />
                    <Button Content="Export file..." Margin="4,0,0,0" Click="Export_OnClick" />
                    <Button Content="Delete" Margin="4,0,0,0" Click="Delete_OnClick" />
                </StackPanel>
                <DataGrid Grid.Row="1" x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" MouseDoubleClick="FileGrid_OnDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                        <DataGridTextColumn Header="Modified (UTC)" Binding="{Binding Modified}" Width="170" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- =============================== status =============================== -->
        <TextBlock Grid.Row="3" x:Name="Status" Text="Ready." Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap" />
    </Grid>
</Window>
