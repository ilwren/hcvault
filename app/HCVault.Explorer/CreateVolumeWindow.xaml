<Window x:Class="HCVault.Explorer.CreateVolumeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vc="clr-namespace:HCVault.Core;assembly=HCVault.Core"
        Title="Create volume" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="Size (MB):" />
        <TextBox x:Name="SizeBox" Text="100" Padding="4" />

        <TextBlock Text="Password:" Margin="0,8,0,0" />
        <PasswordBox x:Name="PwBox" Padding="4" />

        <TextBlock Text="Repeat password:" Margin="0,8,0,0" />
        <PasswordBox x:Name="PwBox2" Padding="4" />

        <TextBlock Text="PIM (0 = default):" Margin="0,8,0,0" />
        <TextBox x:Name="PimBox" Text="0" Padding="4" />

        <TextBlock Text="Key file (optional):" Margin="0,8,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="KeyFileBox" Padding="4" />
            <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Click="BrowseKey_OnClick" />
        </Grid>

        <TextBlock Text="Encryption:" Margin="0,8,0,0" />
        <ComboBox x:Name="CipherBox"
                  ItemsSource="{x:Static vc:HCVaultLibrary.SupportedCiphers}"
                  SelectedIndex="0" />

        <TextBlock Text="Header KDF:" Margin="0,8,0,0" />
        <ComboBox x:Name="KdfBox"
                  ItemsSource="{x:Static vc:HCVaultLibrary.SupportedKdfs}"
                  SelectedIndex="5" />

        <TextBlock Text="Filesystem:" Margin="0,8,0,0" />
        <ComboBox x:Name="FsBox" SelectedIndex="0">
            <ComboBoxItem Content="FAT (built-in)" />
            <ComboBoxItem Content="exFAT (FatFs)" />
            <ComboBoxItem Content="None (raw sectors)" />
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Create" Width="84" IsDefault="True" Click="Create_OnClick" />
            <Button Content="Cancel" Width="84" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
