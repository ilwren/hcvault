<Window x:Class="HCVault.Explorer.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="Prompt" Text="Value:" Margin="0,0,0,6" />
        <TextBox x:Name="Input" Padding="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="72" IsDefault="True" Click="Ok_OnClick" />
            <Button Content="Cancel" Width="72" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
