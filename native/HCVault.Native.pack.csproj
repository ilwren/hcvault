<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stub project so `dotnet pack` can package the native sources via
    HCVault.Native.nuspec:
        cd native && dotnet pack HCVault.Native.pack.csproj
    (Requires the .NET SDK only; nothing is compiled here.)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NuspecFile>HCVault.Native.nuspec</NuspecFile>
    <NuspecProperties>version=1.4.1</NuspecProperties>
    <IsPackable>true</IsPackable>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

</Project>
