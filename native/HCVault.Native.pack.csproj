<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stub project so `dotnet pack` can package the native sources via
    HCVault.Native.nuspec:
        cd native && dotnet pack HCVault.Native.pack.csproj
    (Requires the .NET SDK only; nothing is compiled here.)
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NuspecFile>HCVault.Native.nuspec</NuspecFile>
    <!-- Repository URL is injected at pack time (CI passes
         -p:ProjectUrl/-p:RepositoryUrl from the github context so the
         published package always points at the repository it was built
         from; pass them manually for local packs). -->
    <NuspecProperties>version=1.6.1;projectUrl=$(ProjectUrl);repositoryUrl=$(RepositoryUrl)</NuspecProperties>
    <IsPackable>true</IsPackable>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

</Project>
