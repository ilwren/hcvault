<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>HCVault.Native</id>
    <version>$version$</version>
    <title>HCVault Native (hcvault-core)</title>
    <authors>HCVault contributors</authors>
    <license type="expression">Apache-2.0</license>
    <projectUrl>$projectUrl$</projectUrl>
    <icon>nuget-icon.png</icon>
    <readme>PACKAGE-README.md</readme>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
      Prebuilt native libraries (hcvault-core) used by HCVault.Core: a portable
      subset of the VeraCrypt volume core (create / open / sector I/O / header
      re-encryption for normal and hidden volumes, plus exFAT via the bundled
      FatFs) behind a stable C API (vcapi.h).

      Ships runtimes/{rid}/native binaries for Windows (x64/x86/ARM64), Linux
      (x64) and Android (arm64-v8a/armeabi-v7a/x86/x86_64). Build from the
      repository sources with CMake if you need another platform.
    </description>
    <releaseNotes>1.6.4: no native changes - the binaries are identical in behavior to 1.6.3 (vcapi v6). The version is bumped in lockstep because HCVault.Core 1.6.4 depends on exactly this version. See the HCVault.Core 1.6.4 release notes for the Android native-loader fix.</releaseNotes>
    <copyright>Copyright VeraCrypt contributors; TrueCrypt Foundation; 2026 packaging</copyright>
    <tags>veracrypt;encryption;container;xts;aes;serpent;twofish;kuznyechik;camellia;argon2;native</tags>
    <repository type="git" url="$repositoryUrl$" />
  </metadata>
  <files>
    <!-- build integration + docs + license -->
    <file src="pack/nuget-icon.png" target="" />
    <!-- copies the native library for RID-less (default debug) builds -->
    <file src="pack/HCVault.Native.targets" target="buildTransitive/net8.0" />
    <file src="src/veracrypt/LICENSE-VeraCrypt.txt" target="" />
    <file src="src/fatfs/LICENSE-FatFs.txt" target="" />
    <file src="PACKAGE-README.md" target="" />
    <!-- the prebuilt native libraries (standard NuGet runtimes/ layout) -->
    <!-- the prebuilt native libraries (standard NuGet runtimes/ layout).
         Listed explicitly instead of a wildcard: MSBuild pack joins
         wildcard matches and target differently on Windows and Linux
         (on Windows "runtimes/**/*.dll" + target="runtimes" produced a
         doubled runtimes/runtimes/ prefix, so the libraries were never
         copied to consuming builds - broken in every release before
         1.6.2). Explicit entries are platform-independent; the CI
         "Verify NuGet package contents" step asserts every path. -->
    <file src="runtimes/win-x64/native/hcvault-core.dll" target="runtimes/win-x64/native" />
    <file src="runtimes/win-x86/native/hcvault-core.dll" target="runtimes/win-x86/native" />
    <file src="runtimes/win-arm64/native/hcvault-core.dll" target="runtimes/win-arm64/native" />
    <file src="runtimes/linux-x64/native/libhcvault-core.so" target="runtimes/linux-x64/native" />
    <file src="runtimes/android-arm64/native/libhcvault-core.so" target="runtimes/android-arm64/native" />
    <file src="runtimes/android-arm/native/libhcvault-core.so" target="runtimes/android-arm/native" />
    <file src="runtimes/android-x64/native/libhcvault-core.so" target="runtimes/android-x64/native" />
    <file src="runtimes/android-x86/native/libhcvault-core.so" target="runtimes/android-x86/native" />
  </files>
</package>
