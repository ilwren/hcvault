{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-local",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-local-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64-v8a Release",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a"
      },
      "binaryDir": "${sourceDir}/build-android-arm64"
    },
    {
      "name": "android-x64-release",
      "displayName": "Android x86_64 Release",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      },
      "binaryDir": "${sourceDir}/build-android-x64"
    },
    {
      "name": "android-arm-release",
      "displayName": "Android armeabi-v7a Release",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "armeabi-v7a"
      },
      "binaryDir": "${sourceDir}/build-android-arm"
    },
    {
      "name": "android-x86-release",
      "displayName": "Android x86 Release",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "x86"
      },
      "binaryDir": "${sourceDir}/build-android-x86"
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_PLATFORM": "android-21",
        "ANDROID_STL": "c++_static"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-base",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      },
      "binaryDir": "${sourceDir}/build-win-x64"
    },
    {
      "name": "windows-x86-release",
      "displayName": "Windows x86 Release",
      "inherits": "windows-base",
      "architecture": "Win32",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      },
      "binaryDir": "${sourceDir}/build-win-x86"
    },
    {
      "name": "windows-arm64-release",
      "displayName": "Windows ARM64 Release",
      "inherits": "windows-base",
      "architecture": "ARM64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release"
      },
      "binaryDir": "${sourceDir}/build-win-arm64"
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86-release",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64-release",
      "configuration": "Release"
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release"
    },
    {
      "name": "android-x64-release",
      "configurePreset": "android-x64-release"
    },
    {
      "name": "android-arm-release",
      "configurePreset": "android-arm-release"
    },
    {
      "name": "android-x86-release",
      "configurePreset": "android-x86-release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
