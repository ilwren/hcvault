<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (LTS) is the minimum; net10.0 gets the newest BCL/interp path -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Native AOT: all interop is source-generated ([LibraryImport]) and the
         code uses no reflection, so the library is AOT compatible (verified:
         full publish + functional smoke test on net8.0 and net10.0) -->
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet packaging (source-only: build offline, then `dotnet pack`) -->
    <PackageId>HCVault.Core</PackageId>
    <Version>1.4.1</Version>
    <Authors>HCVault</Authors>
    <Description>
      Managed wrapper around the VeraCrypt volume core: create, open, read and write
      VeraCrypt encrypted containers (normal and hidden volumes, all cipher/KDF
      combinations, keyfiles, PIM) without mounting them. Reference the
      HCVault.Native package for the prebuilt native libraries (or build them
      from the repository sources with CMake).
    </Description>
    <PackageTags>veracrypt;encryption;container;xts;aes;serpent;twofish;kuznyechik;camellia;argon2</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hcvault/hcvault</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="nuget-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Restoring this LIBRARY with an Android RID (dotnet publish -r android-arm
    on a consuming app) derives the .NET 8 runtime pack from the RID graph's
    parent RID: linux-bionic-*. For the 32-bit ABIs those packages were never
    published to nuget.org (Microsoft.NETCore.App.Runtime.linux-bionic-arm /
    -x86 do not exist), which fails the whole app restore with NU1101.
    Android apps get their managed runtime from the Android workload, so
    these pack downloads are pointless: drop them (workaround from
    dotnet/android#8170). The 64-bit variants exist and keep restoring.
  -->
  <Target Name="RemoveNonexistentAndroidRuntimePackDownloads"
          AfterTargets="ProcessFrameworkReferences"
          Condition="'$(RuntimeIdentifier)' != '' or '$(RuntimeIdentifiers)' != ''">
    <ItemGroup>
      <PackageDownload Remove="Microsoft.NETCore.App.Runtime.linux-bionic-arm" />
      <PackageDownload Remove="Microsoft.NETCore.App.Runtime.linux-bionic-x86" />
    </ItemGroup>
  </Target>

  <!--
    The native library is a peer package (HCVault.Native). We intentionally do
    NOT hard-reference it here so this package stays dependency-free; at runtime
    the loader probes (in order):
      1. $VCNATIVE_HOME (directory or full library path)
      2. the application directory
      3. the application directory's runtimes/{rid}/native
      4. native/runtimes/{rid}/native up to 6 levels above the app (repo layout)
      5. the default OS probing (covers NuGet-provided native assets)
  -->

</Project>
