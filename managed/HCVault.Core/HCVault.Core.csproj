<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (LTS) is the minimum; net10.0 gets the newest BCL/interp path -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Native AOT: all interop is source-generated ([LibraryImport]) and the
         code uses no reflection, so the library is AOT compatible (verified:
         full publish + functional smoke test on net8.0 and net10.0) -->
    <IsAotCompatible>true</IsAotCompatible>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet packaging: the metadata lives in the checked-in
         HCVault.Core.nuspec (like the native package), so the nupkg can
         depend on the exact matching HCVault.Native version while this
         project itself stays dependency-free and builds offline.
         Pack (CI/scripts pass the real repository URL):
           dotnet pack -c Release -p:ProjectUrl=... -p:RepositoryUrl=... -->
    <Version>1.6.1</Version>
    <NuspecFile>HCVault.Core.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version);projectUrl=$(ProjectUrl);repositoryUrl=$(RepositoryUrl);configuration=$(Configuration)</NuspecProperties>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Restoring this LIBRARY with an Android RID (dotnet publish -r android-arm
    on a consuming app) derives the .NET 8 runtime pack from the RID graph's
    parent RID: linux-bionic-*. For the 32-bit ABIs those packages were never
    published to nuget.org (Microsoft.NETCore.App.Runtime.linux-bionic-arm /
    -x86 do not exist), which fails the whole app restore with NU1101.
    Android apps get their managed runtime from the Android workload, so
    these pack downloads are pointless: drop them (workaround from
    dotnet/android#8170). The 64-bit variants exist and keep restoring.
  -->
  <Target Name="RemoveNonexistentAndroidRuntimePackDownloads"
          AfterTargets="ProcessFrameworkReferences"
          Condition="'$(RuntimeIdentifier)' != '' or '$(RuntimeIdentifiers)' != ''">
    <ItemGroup>
      <PackageDownload Remove="Microsoft.NETCore.App.Runtime.linux-bionic-arm" />
      <PackageDownload Remove="Microsoft.NETCore.App.Runtime.linux-bionic-x86" />
    </ItemGroup>
  </Target>

  <!--
    The prebuilt native libraries ship as the HCVault.Native package. The
    packaged nupkg declares an exact dependency on it (see HCVault.Core.nuspec),
    but this project does not reference it as a PackageReference, so building
    and testing here stays offline and always uses the locally built library.
    At runtime the loader probes (in order):
      1. $VCNATIVE_HOME (directory or full library path)
      2. the application directory
      3. the application directory's runtimes/{rid}/native
      4. native/runtimes/{rid}/native up to 6 levels above the app (repo layout)
      5. the default OS probing (covers NuGet-provided native assets)
  -->

</Project>
